<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property
        name="accName"
        type="String"
        role="inputOnly"
        default="ACME Enterprise"
      />
            <property
        name="accType"
        datasource="Textiles,Banking,Accounting,Agriculture"
        type="String"
        required="true"
        default="Agriculture"
      />
            <property name="Account" type="@salesforce/schema/Account" />
            <propertyType name="T" extends="SObject" label="sobjectType" />
            <property name="recordId" type="{T}" />
            <property name="recordIds" type="{T[]}" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
